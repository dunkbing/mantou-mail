{
  "name": "mantou-mail",
  "version": "0.0.0",
  "private": true,
  "description": "A desktop mail client built with Mantou (Bun + TypeScript, native UI)",
  "type": "module",
  "scripts": {
    "dev": "mantou run src/main.tsx",
    "build": "mantou build src/main.tsx --name mantou-mail",
    "package:linux": "bun scripts/package-linux.ts",
    "test": "bun test",
    "typecheck": "bun check",
    "demo-server": "bun scripts/demo-server.ts",
    "perf": "bun test ./bench/perf.bench.tsx"
  },
  "dependencies": {
    "imapflow": "2.10.0",
    "mailparser": "3.14.1",
    "mantou-ui": "0.3.1",
    "nodemailer": "10.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "hoodiecrow-imap": "3.3.1",
    "smtp-server": "3.21.3"
  }
}
